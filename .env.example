# T3UD-GSB11 – Beispielkonfiguration / example configuration
#
# Diese Datei dokumentiert alle Variablen, die compose.yaml auswertet.
# Im Normalfall wird .env von scripts/setup.sh erzeugt und muss nicht von
# Hand angelegt werden. Zum Nachschlagen oder für eine nicht-interaktive
# Installation: kopieren nach .env, Werte anpassen, scripts/setup.sh starten.
#
# This file documents every variable compose.yaml consumes. Normally .env is
# generated by scripts/setup.sh. Copy it to .env for reference or for a
# non-interactive install.
#
# ACHTUNG: .env enthält Passwörter und ist in .gitignore ausgenommen.
# NOTE: .env holds secrets and is excluded via .gitignore.

# --- Erreichbarkeit / reachability -----------------------------------------
# GSB_SCHEME: http im lokalen Betrieb, https hinter einem TLS-Reverse-Proxy.
# FRONTEND_DOMAIN/BACKEND_DOMAIN: Adresse inklusive Port, unter der Besucher
# die Seite aufrufen – daraus baut TYPO3 alle absoluten Links.
GSB_SCHEME=http
FRONTEND_DOMAIN=localhost:8080
BACKEND_DOMAIN=localhost:8080

# TRUSTED_HOSTS_PATTERN: regulärer Ausdruck gegen den Host-Header. Nur
# passende Hosts werden bedient; ein falscher Wert liefert HTTP 500.
# Beim Veröffentlichen erweitern – siehe docs/reverse-proxy.md.
TRUSTED_HOSTS_PATTERN='(localhost|127\.0\.0\.1):8080'

# BIND_IP: Host-Adresse, auf der der Port erscheint. 127.0.0.1 = nur dieses
# Notebook. Docker umgeht Host-Firewalls, deshalb ist das die eigentliche
# Absicherung – vor einer Änderung docs/reverse-proxy.md lesen.
BIND_IP=127.0.0.1
HTTP_PORT=8080

# --- Reverse Proxy (leer = lokaler Betrieb) --------------------------------
# REVERSE_PROXY_IP: Adresse, die beim Stack als REMOTE_ADDR ankommt. Nur wenn
# sie passt, wertet TYPO3 die X-Forwarded-Header aus und baut https-Links.
# REVERSE_PROXY_SSL: '*' = alle Proxy-Adressen dürfen HTTPS signalisieren.
REVERSE_PROXY_IP=
REVERSE_PROXY_SSL=

# --- TYPO3 ------------------------------------------------------------------
# TYPO3_CONTEXT: Production oder Development (Development zeigt Fehlerdetails).
TYPO3_CONTEXT=Production
# ALLOWED_MEDIA_DOMAINS: Domains für eingebettete Audio-/Videoinhalte. Der GSB
# liefert '*.bund.de' aus; für eigene Seiten ist '*' üblich.
ALLOWED_MEDIA_DOMAINS='*'
# WITH_DEMO: steuert, ob scripts/setup.sh den Democontent mitinstalliert.
WITH_DEMO=true

# Beschriftung des Backend-Logins / backend login branding
BACKEND_LOGIN_FOOTNOTE='© GSB - ITZBund'
BACKEND_LOGIN_LOGO_ALT='GSB - ITZBund'

# --- Datenbank / database ---------------------------------------------------
# Der Datenbank-Port wird nicht veröffentlicht; die Passwörter erzeugt
# scripts/setup.sh zufällig.
DB_NAME=gsb11
DB_USER=gsb11
DB_PASSWORD='bitte-ersetzen'
DB_ROOT_PASSWORD='bitte-ersetzen'

# --- Backend-Administrator (nur beim Erst-Setup verwendet) ------------------
# TYPO3-Richtlinie: mind. 8 Zeichen mit Groß-, Kleinbuchstabe, Ziffer und
# Sonderzeichen.
TYPO3_ADMIN_USER=admin
TYPO3_ADMIN_PASSWORD='Bitte-Ersetzen-2026.'
TYPO3_ADMIN_EMAIL=admin@localhost

# --- E-Mail / mail ----------------------------------------------------------
# Für die lokale Demo nicht nötig. Ohne SMTP bleibt transport=sendmail – im
# Image gibt es kein sendmail, Formulare und Passwort-Reset schlagen dann fehl.
MAIL_TRANSPORT=sendmail
MAIL_SMTP_SERVER=
MAIL_SMTP_ENCRYPT=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
